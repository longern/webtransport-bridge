# Gateway authentication (default): clients send Proxy-Authorization: Bearer <BRIDGE_TOKEN>.
BRIDGE_TOKEN=replace-with-a-long-random-token
CERT_WEBHOOK_URL=https://pins.example.com/hooks/certificates/replace-with-generated-secret

# For backends with their own authentication, explicitly disable gateway checks:
# BRIDGE_PUBLIC=true
# BRIDGE_TOKEN may then be omitted; any existing value is ignored.
